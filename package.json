    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^10.2.3",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.3",
    "next": "^14.2.5",
    "next-pwa": "^5.6.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
