{
  "name": "ore-no-fusen",
  "version": "3.0.0",
  "description": "俺の付箋 - シンプルで高速なデスクトップ付箋アプリ",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "build:tauri": "cross-env IS_TAURI_BUILD=true next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --ui --coverage",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "release": "npm run tauri build && node scripts/generate-latest-json.mjs",
    "prepare": "husky",
    "perf:check": "node scripts/perf-check.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
