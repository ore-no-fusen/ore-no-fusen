CHANGED=$(git diff --cached --name-only)

# Documentation-only commits cannot affect the application runtime.
# Skip the expensive application checks when every staged file is documentation.
CHECK_MODE=$(node scripts/precommit-classify.mjs)
if [ "$CHECK_MODE" = "skip" ]; then
  echo "[pre-commit] Skipped: documentation-only changes"
  exit 0
fi

echo "[pre-commit] 1-2/3 TypeScript check and unit tests (parallel)..."
set +e
npx tsc --noEmit &
TSC_PID=$!
npm test &
TEST_PID=$!
wait "$TSC_PID"
TSC_STATUS=$?
wait "$TEST_PID"
TEST_STATUS=$?
set -e

if [ "$TSC_STATUS" -ne 0 ] || [ "$TEST_STATUS" -ne 0 ]; then
  echo "[pre-commit] Failed: TypeScript=$TSC_STATUS UnitTests=$TEST_STATUS"
  exit 1
fi

# Run E2E only when app-facing or Tauri files changed.
# PWA/viewer-only changes can skip E2E to keep commits quick.
if echo "$CHANGED" | grep -qE '^(src-tauri|app/components|app/hooks|app/utils|app/page\.|app/layout)'; then
  echo "[pre-commit] 3/3 E2E tests..."
  if command -v powershell.exe >/dev/null 2>&1; then
    echo "[pre-commit] Freeing localhost:3002 before E2E..."
    # NOTE: ポート開放はベストエフォート。3002 が空だと Get-NetTCPConnection が
    # $? を false にして powershell.exe が exit 1 を返し、E2E 到達前にフックが
    # 落ちるため、末尾に exit 0 を付けて常に成功扱いにする。
    powershell.exe -NoProfile -ExecutionPolicy Bypass -Command '$connections = Get-NetTCPConnection -LocalPort 3002 -State Listen -ErrorAction SilentlyContinue; foreach ($connection in $connections) { Stop-Process -Id $connection.OwningProcess -Force -ErrorAction SilentlyContinue }; exit 0'
  fi
  npm run test:e2e
else
  echo "[pre-commit] 3/3 E2E tests skipped: no app-facing/Tauri changes"
fi

echo "[pre-commit] All checks passed."
