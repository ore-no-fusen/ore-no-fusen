npx tsc --noEmit && npm test

# 変更ファイルを確認
CHANGED=$(git diff --cached --name-only)

# Tauri側（src-tauri/）またはデスクトップUI（app/components/, app/hooks/ 等）が変わっていればE2E全実行
# PWA側（app/viewer/, worker/）のみの変更ならE2Eスキップ
if echo "$CHANGED" | grep -qE '^(src-tauri|app/components|app/hooks|app/utils|app/page\.|app/layout)'; then
  npm run test:e2e
else
  echo "E2E skipped: PWA-only changes"
fi
