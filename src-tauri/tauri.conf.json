{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ore-no-fusen",
  "version": "1.1.3",
  "identifier": "com.ore-no-fusen.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3002",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "俺の付箋",
        "width": 240,
        "height": 300,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": true,
        "backgroundColor": "#111827",
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGMTAxMTIyRDg5QjYwQUIKUldTcllKdllJaEVRNzZLTXM2dnR5dUpBUzJ3WGJxOXdWUFZhNUl6WnhPdGRSMHhPb0tiOVI5NWMK",
      "endpoints": [
        "https://github.com/ore-no-fusen/ore-no-fusen/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ONF Studios",
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Japanese"
        ],
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer_header.bmp",
        "sidebarImage": "icons/installer_sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  }
}